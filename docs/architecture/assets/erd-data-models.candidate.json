  "cards": [
    {
      "dot": "cyan",
      "title": "Mongoose References vs Embedded Subdocuments",
      "items": [
        "Core business entities (User, Workspace, Project, Proposal, Milestone, Deliverable, ChangeRequest, ScopeChunk) are standalone Mongoose models with ObjectId references.",
        "Fine-grained auditing and child collections (Workspace.members, ProposalVersion.scopeItems, Milestone.evidence, ChangeRequest.clientDecision) are stored as embedded subdocument arrays."
      ]
    },
    {
      "dot": "emerald",
      "title": "Version Immutability & Compound Indexes",
      "items": [
        "ProposalVersion implements an immutable version snapshot with compound index { proposal: 1, versionNumber: 1 }.",
        "ScopeChunk maintains { project: 1, proposalVersion: 1, chunkIndex: 1 } to allow complete atomic replacement when a new proposal version is approved."
      ]
    }
  ]
