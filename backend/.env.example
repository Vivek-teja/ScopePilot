# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/scopepilot_dev

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# AI Agent & Model Configuration
# AI_PROVIDER: 'local' (zero-dependency default) | 'ollama' | 'gemini' | 'groq'
AI_PROVIDER=local

# Local Ollama Configuration (Optional — for LLM inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: Ollama host for the embedding service (separate from OLLAMA_BASE_URL).
# Leave unset to use the built-in TF.js local embedding fallback (no Ollama required).
# OLLAMA_HOST=http://localhost:11434
# Embedding model used when OLLAMA_HOST is set
OLLAMA_EMBED_MODEL=nomic-embed-text

# Free Tier Cloud Providers (Optional)
# Google Gemini Free API Key (Get free key at: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model name — check current models at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-1.5-flash

# Groq Cloud Free API Key (Get free key at: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
# Groq model name — check current models at https://console.groq.com/docs/models
GROQ_MODEL=llama-3.1-8b-instant
